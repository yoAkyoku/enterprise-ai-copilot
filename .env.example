# Safe local defaults. The synthetic provider does not require credentials.
AGENT_PLATFORM_ENV=development
AGENT_PROVIDER_MODE=synthetic
AGENT_STORAGE_MODE=memory
AGENT_DATA_DIR=.data
AGENT_ATTACHMENT_MAX_BYTES=10485760
AGENT_ATTACHMENT_MAX_PIXELS=25000000
AGENT_ATTACHMENT_RETENTION_DAYS=0
AGENT_ATTACHMENT_REQUIRE_SCAN=false
AGENT_ATTACHMENT_STORAGE=filesystem
AGENT_MALWARE_SCANNER=disabled
AGENT_CLAMAV_HOST=127.0.0.1
AGENT_CLAMAV_PORT=3310
AGENT_CLAMAV_TIMEOUT_SECONDS=10
AGENT_UPLOAD_RATE_LIMIT=30
AGENT_ANALYSIS_RATE_LIMIT=20
AGENT_REDIS_URL=
AGENT_TRACE_ENDPOINT=
AGENT_TRACE_ALLOWED_HOSTS=
AGENT_TRACE_BEARER_TOKEN=
AGENT_TRACE_TIMEOUT_SECONDS=5
AGENT_S3_BUCKET=
AGENT_S3_ENDPOINT=
AGENT_S3_ALLOWED_HOSTS=
AGENT_S3_REGION=
AGENT_S3_PREFIX=attachments
AGENT_S3_KMS_KEY_ID=
AGENT_VISION_ENDPOINT=
AGENT_VISION_API_KEY=
AGENT_VISION_MODEL=
AGENT_VISION_ALLOWED_HOSTS=
AGENT_VISION_TIMEOUT_SECONDS=30
AGENT_MCP_ENDPOINT=
AGENT_MCP_ALLOWED_HOSTS=
AGENT_MCP_BEARER_TOKEN=
AGENT_MCP_TIMEOUT_SECONDS=10
AGENT_MODEL_ENDPOINT=
AGENT_MODEL_API_KEY=
AGENT_MODEL_NAME=
AGENT_MODEL_ALLOWED_HOSTS=
AGENT_MODEL_TIMEOUT_SECONDS=30
AGENT_MODEL_MAX_OUTPUT_CHARS=4000
AGENT_API_HOST=127.0.0.1
AGENT_API_PORT=8000
# Required for the HTTP API. Generate a random local value; do not commit it.
AGENT_AUTH_MODE=bearer
AGENT_API_TOKEN=
# Production/staging must use jwt_hs256 with a secret of at least 32 bytes,
# or oidc_jwks with an HTTPS issuer and exact host allowlist.
AGENT_JWT_SECRET=
AGENT_JWT_ISSUER=
AGENT_JWT_AUDIENCE=
AGENT_OIDC_ISSUER=
AGENT_OIDC_AUDIENCE=
AGENT_OIDC_JWKS_URI=
AGENT_OIDC_ALLOWED_HOSTS=
