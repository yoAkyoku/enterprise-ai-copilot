# Copy to a secret-managed file such as .env.production; do not commit that file.
AGENT_PLATFORM_ENV=production
AGENT_PROVIDER_MODE=remote
AGENT_STORAGE_MODE=sqlite
AGENT_DATA_DIR=/app/.data

# Use an OIDC provider in production. The issuer and JWKS hosts must be HTTPS
# and must match the exact allowlist below.
AGENT_AUTH_MODE=oidc_jwks
AGENT_OIDC_ISSUER=https://identity.example.invalid
AGENT_OIDC_AUDIENCE=enterprise-agent-api
AGENT_OIDC_JWKS_URI=https://identity.example.invalid/.well-known/jwks.json
AGENT_OIDC_ALLOWED_HOSTS=identity.example.invalid

# Remote MCP/ERP boundary. The connector must enforce the trusted scope headers
# and return source_id, observed_at and external_ref provenance fields.
AGENT_MCP_ENDPOINT=https://erp-mcp.example.invalid/mcp
AGENT_MCP_ALLOWED_HOSTS=erp-mcp.example.invalid
AGENT_MCP_BEARER_TOKEN=REPLACE_WITH_SECRET_REFERENCE
AGENT_MCP_TIMEOUT_SECONDS=10

# Redis is used for distributed request limiting and scheduled-job workers.
AGENT_REDIS_URL=redis://redis:6379/0
AGENT_UPLOAD_RATE_LIMIT=30
AGENT_ANALYSIS_RATE_LIMIT=20

# Production attachments require encrypted object storage, scanning and expiry.
AGENT_ATTACHMENT_STORAGE=s3
AGENT_ATTACHMENT_RETENTION_DAYS=30
AGENT_ATTACHMENT_REQUIRE_SCAN=true
AGENT_MALWARE_SCANNER=clamav
AGENT_CLAMAV_HOST=clamav.internal.example.invalid
AGENT_CLAMAV_PORT=3310
AGENT_CLAMAV_TIMEOUT_SECONDS=10
AGENT_S3_BUCKET=REPLACE_WITH_BUCKET
AGENT_S3_REGION=REPLACE_WITH_REGION
AGENT_S3_ENDPOINT=
AGENT_S3_ALLOWED_HOSTS=
AGENT_S3_PREFIX=attachments
AGENT_S3_KMS_KEY_ID=REPLACE_WITH_KMS_KEY_ID

# Optional OpenAI-compatible Vision/OCR provider. Leave all values empty to
# disable image egress; if enabled, configure an HTTPS allowlisted endpoint.
AGENT_VISION_ENDPOINT=
AGENT_VISION_API_KEY=
AGENT_VISION_MODEL=
AGENT_VISION_ALLOWED_HOSTS=
AGENT_VISION_TIMEOUT_SECONDS=30

# Compose reads this path when it is exported in the invoking environment:
# AGENT_ENV_FILE=.env.production docker compose up -d --build
